{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline",
  "description": "Edit Decision List di Reel Studio. Tutti i tempi sono in secondi. I tempi di clips sono relativi al video sorgente; quelli di overlays sono relativi al video finale.",
  "type": "object",
  "required": ["clips"],
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "height": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "fps": { "type": "number", "minimum": 15, "maximum": 60 }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "in", "out"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "integer", "description": "ID dell'asset video" },
          "in": { "type": "number", "minimum": 0 },
          "out": { "type": "number", "exclusiveMinimum": 0 },
          "zoom": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "number", "minimum": 1, "maximum": 2 },
              "to": { "type": "number", "minimum": 1, "maximum": 2 }
            }
          },
          "transition_in": { "enum": ["cut", "fade"] },
          "note": { "type": "string" }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "font": { "type": "string" },
        "size": { "type": "number", "minimum": 20, "maximum": 200 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "highlight": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "outline": { "type": "number", "minimum": 0, "maximum": 20 },
        "position_y": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "max_words": { "type": "integer", "minimum": 1, "maximum": 8 },
        "uppercase": { "type": "boolean" },
        "animation": { "enum": ["none", "pop", "fade"] },
        "emphasis": { "type": "array", "items": { "type": "string" } },
        "corrections": { "type": "object", "additionalProperties": { "type": "string" } },
        "hidden_ranges": {
          "type": "array",
          "description": "Intervalli [start, end] del video finale senza sottotitoli",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["image", "text"] },
          "asset": { "type": "integer", "description": "ID asset immagine (kind=image)" },
          "text": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0.02, "maximum": 1, "description": "Larghezza immagine come frazione della larghezza del video" },
          "size": { "type": "number", "minimum": 20, "maximum": 260 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "animation": { "enum": ["none", "fade", "pop"] }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": { "type": ["integer", "null"] },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "duck": { "type": "boolean" },
        "start_offset": { "type": "number", "minimum": 0 },
        "fade_out": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalize": { "type": "boolean" },
        "voice_gain_db": { "type": "number", "minimum": -20, "maximum": 20 }
      }
    }
  }
}
