# Copia questo file in .env e compila le voci che ti servono.

# --- Agente ----------------------------------------------------------------------
# claude-cli    = usa la tua sessione/abbonamento di Claude Code (`claude -p`), nessuna API key
# codex-cli     = usa la tua sessione di Codex (`codex exec`)
# anthropic-api = API Anthropic a consumo (serve ANTHROPIC_API_KEY)
AGENT_PROVIDER=claude-cli
AGENT_MODEL=opus
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Trascrizione ----------------------------------------------------------------
# large-v3-turbo: ottimo per l'italiano. Più veloce ma meno preciso: small / medium
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=it

# --- URL ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Tunnel HTTPS pubblico (Cloudflare) verso http://localhost:8000.
# Serve per: webhook DM di Instagram, pubblicazione Reels, link pubblici ai lead magnet, OAuth Instagram/TikTok.
PUBLIC_BASE_URL=

# --- Instagram (app Meta con "Instagram API with Instagram Login") ---------------
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=reel-studio
IG_API_VERSION=v26.0

# --- YouTube (Google Cloud: OAuth client "Web application", YouTube Data API v3) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok (developers.tiktok.com: Login Kit + Content Posting API) -------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
